  "bug_report_content": "{\"id\":204,\"status\":\"Fixed\",\"summary\":\"Add support for data members on interfaces\",\"labels\":[\"Type-Defect\",\"Priority-Medium\"],\"stars\":2,\"commentCount\":4,\"comments\":[{\"id\":0,\"commenterId\":6454800031398885070,\"content\":\"/**\\r\\n * @interface\\r\\n */\\r\\nfunction I() {};\\r\\n\\r\\n/** @type {string} */\\r\\nI.prototype.foobar;\\r\\n\\r\\n/**\\r\\n * @constructor\\r\\n * @implements {I}\\r\\n */\\r\\nfunction C() {\\r\\n  // No warning generated here.\\r\\n  this.foobar \\u003d 2;\\r\\n};\\r\\n\\r\\n/** @type {I} */\\r\\nvar test \\u003d new C(); \\r\\nalert(test.foobar);\",\"timestamp\":1280185085,\"attachments\":[]},{\"id\":1,\"commenterId\":-5060162230523776870,\"content\":\"\",\"timestamp\":1285956268,\"attachments\":[]},{\"id\":2,\"commenterId\":-5060162230523776870,\"content\":\"Just an update here.  I made a couple of changes last year to improve date member support, and they are properly checked on prototype definitions (For the sample above, C.prototype.foobar \\u003d 2 would generate an error) \",\"timestamp\":1295898960,\"attachments\":[]},{\"id\":3,\"commenterId\":-7699928860083865744,\"content\":\"This issue was closed by revision r829.\",\"timestamp\":1299016556,\"attachments\":[]}]}",
