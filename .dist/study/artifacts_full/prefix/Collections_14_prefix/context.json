      "content": "   121: \n   122:     // COLLECTIONS-294\n   123:     public void testLocaleIndependence() {\n   124:         Locale orig = Locale.getDefault();\n   125: \n   126:         Locale[] locales = { Locale.ENGLISH, new Locale(\"tr\"), Locale.getDefault() };\n   127: \n   128:         String[][] data = { \n   129:             { \"i\", \"I\" },\n   130:             { \"\\u03C2\", \"\\u03C3\" },\n   131:             { \"\\u03A3\", \"\\u03C2\" },\n   132:             { \"\\u03A3\", \"\\u03C3\" },\n   133:         };\n   134: \n   135:         try {\n   136:             for (int i = 0; i < locales.length; i++) {\n   137:                 Locale.setDefault(locales[i]);\n   138:                 for (int j = 0; j < data.length; j++) {\n   139:                     assertTrue(\"Test data corrupt: \" + j, data[j][0].equalsIgnoreCase(data[j][1]));\n   140:                     CaseInsensitiveMap map = new CaseInsensitiveMap();\n   141:                     map.put(data[j][0], \"value\");\n   142:                     assertEquals(Locale.getDefault() + \": \" + j, \"value\", map.get(data[j][1]));\n   143:                 }\n   144:             }\n   145:         } finally {\n   146:             Locale.setDefault(orig);\n   147:         }\n   148:     }\n   149: \n   150: }"
