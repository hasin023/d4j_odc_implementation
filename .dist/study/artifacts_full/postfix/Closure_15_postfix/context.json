  "bug_report_content": "{\"id\":773,\"status\":\"Fixed\",\"summary\":\"Switched order of \\\"delete key\\\" and \\\"key in\\\" statements changes semantic\",\"labels\":[\"Type-Defect\",\"Priority-Medium\"],\"stars\":0,\"commentCount\":5,\"comments\":[{\"id\":0,\"commenterId\":-6885360950181397962,\"content\":\"// Input:\\r\\n\\r\\nvar customData \\u003d { key: \\u0027value\\u0027 };\\r\\n\\r\\nfunction testRemoveKey( key ) {\\r\\n\\tvar dataSlot \\u003d customData,\\r\\n\\t\\tretval \\u003d dataSlot \\u0026amp;\\u0026amp; dataSlot[ key ],\\r\\n\\t\\thadKey \\u003d dataSlot \\u0026amp;\\u0026amp; ( key in dataSlot );\\r\\n\\r\\n\\tif ( dataSlot )\\r\\n\\t\\tdelete dataSlot[ key ];\\r\\n\\r\\n\\treturn hadKey ? retval : null;\\r\\n};\\r\\n\\r\\nconsole.log( testRemoveKey( \\u0027key\\u0027 ) ); // \\u0027value\\u0027\\r\\nconsole.log( \\u0027key\\u0027 in customData ); // false\\r\\n\\r\\n\\r\\n// Compiled version:\\r\\n\\r\\nvar customData\\u003d{key:\\u0026quot;value\\u0026quot;};function testRemoveKey(b){var a\\u003dcustomData,c\\u003da\\u0026amp;\\u0026amp;a[b];a\\u0026amp;\\u0026amp;delete a[b];return a\\u0026amp;\\u0026amp;b in a?c:null}console.log(testRemoveKey(\\u0026quot;key\\u0026quot;));console.log(\\u0026quot;key\\u0026quot;in customData);\\r\\n\\r\\n// null\\r\\n// false\\r\\n\\r\\n\\r\\n\\u0026quot;b in a\\u0026quot; is executed after \\u0026quot;delete a[b]\\u0026quot; what obviously doesn\\u0027t make sense in this case.\\r\\n\\r\\n\\r\\nReproducible on: http://closure-compiler.appspot.com/home and in \\u0026quot;Version: 20120430 (revision 1918) Built on: 2012/04/30 18:02\\u0026quot;\",\"timestamp\":1341844793,\"attachments\":[]},{\"id\":1,\"commenterId\":-7699928860083865744,\"content\":\"ack. thanks for the report\",\"timestamp\":1341848778,\"attachments\":[]},{\"id\":2,\"commenterId\":-7699928860083865744,\"content\":\"john figured this out first.\",\"timestamp\":1341866393,\"attachments\":[]},{\"id\":3,\"commenterId\":-7699928860083865744,\"conte