# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class
/.rtk

# Test, lint, and type-check caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.pyre/
.hypothesis/

# Virtual environments
.venv/
venv/
env/
ENV/

# Local environment and secrets
.env
.env.*
*.local
!.env.example

# Build and packaging outputs
build/
dist/
site/
*.egg-info/
.eggs/
pip-wheel-metadata/

# Coverage and reports
.coverage
.coverage.*
htmlcov/
coverage.xml

# Defects4J working directories and experiment artifacts
work/
# work/ is an exact-name pattern, so suffixed roots (work_pilot_v2/, work_v2/)
# would otherwise show up in git status full of hundreds of MB of checkouts.
work_*/
# WARNING: do NOT widen this to artifacts*/. It looks like a bug and is not —
# the numbered/named roots (artifacts_full/, artifacts_v2/) are deliberately
# TRACKED, and widening this would silently ignore ~7,900 committed files.
artifacts/
!study/artifacts/
!study/artifacts/**
!.dist/study/artifacts/
!.dist/study/artifacts/**
outputs/
# Root-anchored: a bare `reports/` also matched scripts/reports/, which hid the
# xlsx generator from the repo. Nested build reports live under work/, already ignored.
/reports/
logs/
tmp/
temp/

# Notebook and interactive session noise
.ipynb_checkpoints/

# Editor and OS files
.idea/
.vscode/
*.swp
*.swo
Thumbs.db
.DS_Store 
# scripts/ is intentionally NOT ignored: it holds the reproducible report
# generator and the context readiness gate, which teammates need from a clone.
# Git cannot re-include a file inside an excluded directory, so this cannot be
# a blanket ignore with exceptions — keep scratch work out by hand, or under
# scripts/scratch/ below.
scripts/scratch/
debug_missing.py
.dist/.odc_history
.dist/.odc_session.json
