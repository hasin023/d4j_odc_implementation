# ── Default LLM provider (used when --provider is omitted) ───────────
# Change this to switch the active provider (gemini | openrouter | groq | openai-compatible)
DEFAULT_LLM_PROVIDER=gemini
DEFAULT_LLM_MODEL=gemini-3.1-flash-lite

# ── Gemini ───────────────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
# Optional: comma-separated multiple keys to rotate across (e.g. one per team
# member's free-tier account), spreading RPM/RPD load. Rotation is per-request
# (every LLM call advances to the next key, even across turns of one bug's
# --strategy scientific loop and across separate bugs) — takes priority over
# GEMINI_API_KEY above when set. Only actually multiplies your quota if the
# keys belong to separate Google accounts/projects, not two keys under one
# account.
# GEMINI_API_KEYS=your_first_gemini_api_key_here,your_second_gemini_api_key_here
# Free tier: both gemini-3.1-flash-lite and gemini-3.5-flash-lite give 500
# RPD (the most generous free Gemini tier) — see docs/llm_model_selection.md.
# gemini-3.1-flash-lite: the default/less-powerful pick (zero, and few/scientific
# primary). gemini-3.5-flash-lite: the more-powerful pick — pass
# --model gemini-3.5-flash-lite for a second-model run on scientific/few
# (same key, no separate env var needed).
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_MODEL=gemini-3.1-flash-lite

# ── OpenRouter ───────────────────────────────────────────────────────
# Verified LIVE against the real /v1/models pricing 2026-08-10 (OpenRouter's
# free roster changes often — re-verify before trusting this list again).
# deepseek/deepseek-v3.2 (the old default here) is NOT free — confirmed
# non-zero pricing. nvidia/nemotron-3-ultra-550b-a55b:free IS confirmed $0
# and is the strongest free model found on ANY provider we checked (71.9%
# SWE-bench Verified, 1M context) — best `few`/`scientific` secondary pick.
# Other confirmed-free options as of the same check: openai/gpt-oss-20b:free
# (lighter), nvidia/nemotron-3-super-120b-a12b:free, google/gemma-4-31b-it:free.
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
OPENROUTER_HTTP_REFERER=https://your-project-site.example
OPENROUTER_APP_TITLE=Defects4J ODC Pipeline

# ── Groq ─────────────────────────────────────────────────────────────
# Verified LIVE 2026-08-10 (GET /v1/models with a real key): both models
# below are confirmed present and active.
GROQ_API_KEY=your_groq_api_key_here
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-120b

# ── Second model per strategy (see docs/condition_model.md §5 for the
# model axis, docs/llm_model_selection.md for the researched tier list) ──
# The OpenRouter nvidia/nemotron-3-ultra-550b-a55b:free model above already
# covers the core `few`/`scientific` secondary slot — no second provider
# needed for the primary comparison.
#
# SambaNova Cloud: NOT free (checked LIVE 2026-08-10, all 6 models carry
# real per-token pricing) — but usable as a BUDGET-CAPPED BONUS run against
# a $5.00 signup-bonus credit (no public balance API — watch the real number
# on the SambaNova dashboard while running). See docs/llm_model_selection.md
# "SambaNova bonus budget" for the cost math; ballpark: ~150 `few` calls or
# ~35 `scientific` bug-arms before $5 runs out — pass
# --daily-call-budget accordingly. Drop this block entirely once exhausted.
#   d4j-odc study-run ... --provider openai-compatible \
#     --base-url https://api.sambanova.ai/v1 --api-key-env SAMBANOVA_API_KEY \
#     --model DeepSeek-V3.2 --daily-call-budget 150
SAMBANOVA_API_KEY=your_sambanova_api_key_here

# ── Defects4J ────────────────────────────────────────────────────────
# Recommended Windows setup: keep the Defects4J clone inside WSL on the Linux filesystem.
# Example: DEFECTS4J_CMD=wsl perl /home/your-linux-user/defects4j/framework/bin/defects4j
DEFECTS4J_CMD=wsl perl /home/your-linux-user/defects4j/framework/bin/defects4j
DEFECTS4J_PATH_STYLE=wsl

# Multi-fault data directory (defects4j-mf fault_data/)
# If unset, the pipeline looks for ./fault_data/ relative to the implementation root.
MULTIFAULT_DATA_DIR=./fault_data
